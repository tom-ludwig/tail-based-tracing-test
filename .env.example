PG_LOCAL=false
PG_SSLMODE="verify-full"
DEBUG_MODE=false
# LOCAL DEVELOPMENT CONFIGURATION

# Server Configuration
PORT=8080
LOG_LEVEL=INFO
# Database Configuration (Local Development)
PG_LOCAL=true
PG_HOST=localhost
PG_PORT=5433
PG_DB=orbis
PG_USER=user
PG_PASSWORD=password
PG_SSLMODE=disable

# CORS Configuration (Permissive for Local Development)
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
CORS_EXPOSED_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

OIDC_ENABLED=false
OIDC_ISSUER=https://test.com
OIDC_AUDIENCE=me

# OpenTelemetry Tracing
# Tracing is enabled when OTEL_EXPORTER_OTLP_ENDPOINT is set; leave it empty
# to disable. The SDK always-samples — the tail-based sampling decision is
# made by the collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.observability.svc.cluster.local:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc                          # grpc (default) or http/protobuf
# OTEL_EXPORTER_OTLP_INSECURE=true                          # disable TLS (gRPC only; dev/in-cluster plaintext)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer xxx       # optional auth headers
# OTEL_SERVICE_NAME=go-server-template                      # overrides the in-code default
#
# Examples:
#   gRPC to OTel collector:
#     OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
#     OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#     OTEL_EXPORTER_OTLP_INSECURE=true
#
#   HTTP straight to VictoriaTraces (bypassing the collector):
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:10428/insert/opentelemetry/v1/traces
#     OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# =============================================================================
# PRODUCTION CONFIGURATION (Uncomment and adjust as needed)

# Server Configuration
# PORT=8080
# LOG_LEVEL=INFO

# Database Configuration (Production with TLS)
# PG_LOCAL=false
# PG_HOST=your-production-db-host.example.com
# PG_PORT=5432
# PG_DB=your_production_db
# PG_USER=your_db_user
# PG_SSLMODE=verify-full
# PG_CLIENT_CERT=/certs/tls.crt
# PG_CLIENT_KEY=/certs/tls.key
# PG_SSLROOTCERT=/certs/ca.crt

# CORS Configuration (Restrictive for Production)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
# CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token
# CORS_EXPOSED_HEADERS=Link
# CORS_ALLOW_CREDENTIALS=true
# CORS_MAX_AGE=300

# OIDC_ENABLED=true
# OIDC_ISSUER=https://<issuer>.com
# OIDC_AUDIENCE=<audience>

# OpenTelemetry Tracing (Production)
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.observability.svc.cluster.local:4317
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
# OTEL_SERVICE_NAME=go-server-template
